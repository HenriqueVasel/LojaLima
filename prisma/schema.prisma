generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cartitem {
  id             Int             @id @default(autoincrement())
  userId         String
  productId      Int
  variantId      Int?
  qty            Int             @default(1)
  createdAt      DateTime        @default(now())
  product        product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productvariant productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId], map: "CartItem_productId_fkey")
  @@index([userId], map: "CartItem_userId_idx")
  @@index([variantId], map: "CartItem_variantId_fkey")
}

model category {
  id              Int               @id @default(autoincrement())
  name            String
  slug            String            @unique(map: "Category_slug_key")
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  parentId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  featured        Boolean           @default(false)
  category        category?         @relation("categoryTocategory", fields: [parentId], references: [id])
  other_category  category[]        @relation("categoryTocategory")
  productcategory productcategory[]
  attributes      CategoryAttribute[]

  @@index([active, sortOrder], map: "Category_active_sortOrder_idx")
  @@index([parentId], map: "Category_parentId_idx")
}

model order {
  id                 String       @id @default(cuid())
  createdAt          DateTime     @default(now())
  status             order_status @default(pending)
  customerEmail      String
  customerObs        String?
  customerWhats      String
  customerName       String
  totalCents         Int
  userId             String?
  customerCpf        String
  shippingCents      Int          @default(0)
  cep                String?
  street             String?
  number             String?
  neighborhood       String?
  city               String?
  state              String?
  carrier            String?
  lastTrackingUpdate DateTime?
  shippingStatus     String?      @default("processing")
  trackingCode       String?
  trackingUrl        String?
  customerCnpj       String?
  customerIe         String?
  customerType       String?
  user               user?        @relation(fields:[userId], references:[id])
  orderitem          orderitem[]
  payment            payment?

  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_idx")
}

model orderitem {
  id             Int             @id @default(autoincrement())
  orderId        String
  slug           String
  qty            Int
  imageUrl       String?
  name           String
  priceCents     Int
  productId      Int?
  variantId      Int?
  order          order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        product?        @relation(fields: [productId], references: [id])
  productvariant productvariant? @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_fkey")
  @@index([variantId], map: "OrderItem_variantId_fkey")
}

model payment {
  id          String         @id @default(cuid())
  orderId     String         @unique(map: "Payment_orderId_key")
  provider    String
  status      payment_status @default(pending)
  amountCents Int
  externalId  String?
  createdAt   DateTime       @default(now())
  order       order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model product {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique(map: "Product_slug_key")
  description      String?
  priceCents       Int
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  brand            String?
  sku              String?           @unique(map: "Product_sku_key")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  highlight        Boolean           @default(false)
  priority         Int               @default(0)
  ean              String?
  supplier         String?
  promotionId      String?
  shortDescription String?
  isKit            Boolean           @default(false)
  coupon_group     String?           @db.VarChar(50)
  promoMonth       Boolean           @default(false)
  height           Float?
  length           Float?
  weight           Float?
  width            Float?
  kitItems         KitItem[]         @relation("KitProducts")
  usedInKits       KitItem[]         @relation("KitItemProduct")
  cartitem         cartitem[]
  orderitem        orderitem[]
  promotion        Promotion?        @relation(fields: [promotionId], references: [id])
  productcategory  productcategory[]
  productimage     productimage[]
  productvariant   productvariant[]
  stock            stock?
brandRefId Int?
brandRef Brand? @relation("ProductBrand", fields: [brandRefId], references: [id])

lineId Int?
line ProductLine? @relation(fields: [lineId], references: [id])

attributes ProductAttribute[]

  @@index([active, featured], map: "Product_active_featured_idx")
  @@index([name], map: "Product_name_idx")
  @@index([brandRefId])
  @@index([lineId])
}

model productcategory {
  productId  Int
  categoryId Int
  createdAt  DateTime @default(now())
  category   category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId], map: "ProductCategory_categoryId_idx")
}

model productimage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder], map: "ProductImage_productId_sortOrder_idx")
}

model productvariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String
  sku        String?     @unique(map: "ProductVariant_sku_key")
  priceCents Int?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartitem   cartitem[]
  orderitem  orderitem[]
  product    product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock      stock?

  @@index([productId, active], map: "ProductVariant_productId_active_idx")
}

model stock {
  id             Int             @id @default(autoincrement())
  productId      Int?            @unique(map: "Stock_productId_key")
  variantId      Int?            @unique(map: "Stock_variantId_key")
  quantity       Int             @default(0)
  updatedAt      DateTime        @updatedAt
  product        product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productvariant productvariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantity], map: "Stock_quantity_idx")
}

model user {
  id                   String     @id @default(cuid())
  name                 String
  email                String     @unique(map: "User_email_key")
  password             String
  role                 user_role  @default(CLIENT)
  createdAt            DateTime   @default(now())
  emailVerified        Boolean    @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  emailLastError       String?
  emailLastSent        DateTime?
  emailStatus          String?    @default("pending")
  resendEmailId        String?
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  cartitem             cartitem[]
  order                order[]
}

model Coupon {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(50)
  type         String    @db.VarChar(20)
  value        Decimal   @db.Decimal(10, 2)
  min_purchase Decimal?  @default(0) @db.Decimal(10, 2)
  expires_at   DateTime? @db.Timestamp(6)
  active       Boolean?  @default(true)
  usage_limit  Int?
  used_count   Int?      @default(0)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  product_id   Int?
  coupon_group String?   @db.VarChar(50)

  @@map("coupons")
}

model Promotion {
  id            String    @id @default(cuid())
  title         String
  active        Boolean   @default(true)
  discountType  String
  discountValue Float
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  products      product[]
}

model KitItem {
  id        String  @id @default(cuid())
  kitId     Int
  productId Int
  quantity  Int
  kit       product @relation("KitProducts", fields: [kitId], references: [id])
  product   product @relation("KitItemProduct", fields: [productId], references: [id])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  product[] @relation("ProductBrand")
}

model ProductLine {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  products  product[]

  @@unique([name])
}

model Attribute {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  values      AttributeValue[]
  categories  CategoryAttribute[]
}

model AttributeValue {
  id          Int                @id @default(autoincrement())
  attributeId Int
  value       String
  slug        String
  sortOrder   Int                @default(0)

  attribute   Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  products    ProductAttribute[]

  @@unique([attributeId, slug])
}

model CategoryAttribute {

  categoryId  Int
  attributeId Int

  category     category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])

}

model ProductAttribute {
  productId        Int
  attributeValueId Int

  product          product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
}

enum order_status {
  pending
  paid
  canceled
  shipped
  completed
}

enum payment_status {
  pending
  approved
  rejected
  canceled
}

enum user_role {
  ADMIN
  CLIENT
}
